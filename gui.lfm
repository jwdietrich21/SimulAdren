        OnClick = WinAboutItemClick
      end
    end
  end
  object SaveDialog1: TSaveDialog
    Title = 'Save results or current simulation as a scenario'
    DefaultExt = '.tsv'
    Filter = 'Log (tab delimited)|*.tsv|Log (CSV)|*.csv|Log (DIF)|*.dif|Scenario|*.xml'
    Options = [ofOverwritePrompt, ofEnableSizing, ofViewDetail, ofAutoPreview]
    Left = 432
    Top = 104
  end
  object OpenDialog1: TOpenDialog
    Title = 'Open parameter set as scenario'
    Filter = 'Scenario (XML)|*.xml'
    Options = [ofEnableSizing, ofViewDetail, ofAutoPreview]
    Left = 360
    Top = 104
  end
